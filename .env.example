# ==============================================================================
# QuantLab — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in the real values.
# Never commit `.env` or any secret (RULE 028 and RULE 051).
# Only variables prefixed with VITE_ reach the browser, so they may hold public
# values only (project URL and publishable key), never a secret.
# Use separate Supabase projects for development and production.

# ------------------------------------------------------------------------------
# Django Backend
# ------------------------------------------------------------------------------
DJANGO_ENV=development
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database (Supabase)
# ------------------------------------------------------------------------------
# Supabase Dashboard -> Connect -> Session pooler (docs/plano-de-implantacao.md, S5).
# The direct connection (db.[PROJECT_REF].supabase.co) is IPv6-only without the
# IPv4 add-on; the session pooler works over IPv4 and supports prepared statements.
# The pooler user includes the project ref: "<role>.<PROJECT_REF>".
# Use the dedicated role quantlab_backend (decision D4), never "postgres" in the app.
# The backend must filter every query by owner; RLS is the second layer.
DATABASE_URL=postgresql://quantlab_backend.[PROJECT_REF]:[DB_PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Supabase (backend)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_REF].supabase.co
# Public key: the sb_publishable_... key, or the legacy anon JWT.
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# User tokens are verified with the project's public signing keys (JWKS) at
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# so no JWT secret is needed, and none must be kept here (RULE 025).

# ------------------------------------------------------------------------------
# Frontend (Vite + React)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Add when the frontend calls the Django API:
# VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# Not needed yet: uncomment when the phase arrives
# ------------------------------------------------------------------------------
# Phase 3.2, Storage: the secret key replaces the legacy service_role key. It
# ignores RLS and is for the backend only (RULE 028): never in VITE_ variables.
# SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# SUPABASE_STORAGE_EXPERIMENT_ARTIFACTS_BUCKET=experiment-artifacts
# SUPABASE_STORAGE_MARKET_DATA_CACHE_BUCKET=market-data-cache
#
# Phase 6, asynchronous tasks (Celery + Redis):
# REDIS_URL=redis://localhost:6379/0
